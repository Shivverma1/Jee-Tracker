# ─── Root reference for all environment variables ───
# Copy the relevant block into backend/.env and frontend/.env.

# Backend (backend/.env) — all OPTIONAL; app runs in mock mode without them.
YOUTUBE_API_KEY=your_key_here
SUPABASE_URL=your_url_here
SUPABASE_KEY=your_key_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (frontend/.env)
# Leave blank locally to use the Vite dev proxy; set to the deployed API URL in production.
VITE_API_URL=
